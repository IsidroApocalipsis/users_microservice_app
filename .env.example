PORT=3000
NODE_ENV=development

# 32 bytes in base64. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

MONGODB_URI=mongodb://127.0.0.1:27017/users?retryWrites=false

# At least 32 characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=1h

SEED_ADMIN_NOMBRE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
